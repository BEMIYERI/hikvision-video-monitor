# HIKVISION VIDEO MONITOR — configuration
# Copier ce fichier en config/.env puis remplir les valeurs.
# config/.env ne doit JAMAIS etre partage, commite ou colle dans un chat.

# Identifiants communs aux enregistreurs (compte lecture seule recommande)
NVR_USER=utilisateur
NVR_PASS=A-REMPLIR

# Enregistreurs : NOM|IP|PORT|SITE (jusqu'a NVR16)
NVR1=SITE-A|192.168.1.10|80|Batiment A
NVR2=SITE-B|192.168.1.11|80|Batiment B

POLL_INTERVAL=60
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Obligatoire des que DASHBOARD_HOST n'est plus 127.0.0.1
DASHBOARD_TOKEN=

# Ecriture sur les NVR (renommage des cameras) : false = lecture seule stricte
ALLOW_NVR_WRITE=false
RETENTION_DAYS=90
